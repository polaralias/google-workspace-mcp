{
  "name": "google-workspace-mcp",
  "private": true,
  "description": "Docker and local runtime helpers for google-workspace-mcp",
  "scripts": {
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:up": "docker compose up -d --build --remove-orphans",
    "google:keep-master-token": "uv run -- python scripts/google_keep_master_token.py",
    "google:oauth": "uv run -- python scripts/google_oauth_helper.py",
    "mcp:doctor": "python scripts/run_server.py doctor",
    "mcp:serve": "python scripts/run_server.py serve",
    "mcp:url": "python scripts/run_server.py url"
  }
}
