# Escape literal `$` characters as `$$` when using Docker Compose env files.

# Required MCP client auth
GOOGLE_WORKSPACE_MCP_API_KEY=change-me

# Separate Google sign-in for MCP clients (see docs/mcp-oauth.md).
# MCP_AUTH_MODE=google-oauth
# MCP_OAUTH_GOOGLE_CLIENT_ID=your-google-web-client-id
# MCP_OAUTH_GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# MCP_OAUTH_BASE_URL=https://google-workspace-mcp.example.com
# MCP_OAUTH_SIGNING_KEY=generate-a-stable-random-secret-of-at-least-32-characters
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com

# Preferred persisted Google OAuth location used by docker-compose.yml
GOOGLE_MCP_CREDENTIALS_DIR=/app/.oauth

# Optional generic aliases
# MCP_API_KEY=change-me
# MCP_API_KEYS=key-one,key-two

# Optional OAuth helper settings
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Optional Google Keep and public API settings
# GOOGLE_DEFAULT_USER_EMAIL=user@example.com
# GOOGLE_KEEP_EMAIL=user@example.com
# GOOGLE_KEEP_MASTER_TOKEN=your-master-token
# GOOGLE_KEEP_MANAGED_LABEL=google-workspace-mcp
# GOOGLE_KEEP_UNSAFE_MODE=false
# GOOGLE_API_KEY=your-google-api-key
# MASTER_KEY=legacy-decryption-key

# Optional endpoint overrides
# GOOGLE_WORKSPACE_MCP_PORT=3002
# GOOGLE_WORKSPACE_MCP_HOST_PORT=3002
# GOOGLE_WORKSPACE_MCP_PATH=/mcp

# Optional runtime tuning
# API_KEY_MODE=disabled
