      "parameters": {
        "type": "object",
        "properties": {
          "user_google_email": {
            "type": "string"
          },
          "spreadsheet_id": {
            "type": "string"
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "major_dimension": {
            "type": "string",
            "enum": [
              "ROWS",
              "COLUMNS"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "user_google_email",
          "spreadsheet_id",
          "ranges"
        ]
      }
    },
