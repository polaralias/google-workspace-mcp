{
  "tools": [
    {
      "name": "append_sheet_rows",
      "description": "Append rows to a Google Sheet.",
      "parameters": {
        "type": "object",
        "properties": {
          "user_google_email": {
            "type": "string"
          },
          "spreadsheet_id": {
            "type": "string"
          },
          "range_name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            }
          },
          "value_input_option": {
            "type": "string",
            "enum": [
              "RAW",
              "USER_ENTERED"
            ],
            "default": "USER_ENTERED"
          },
          "insert_data_option": {
            "type": "string",
            "enum": [
              "OVERWRITE",
              "INSERT_ROWS"
            ],
            "default": "INSERT_ROWS"
          }
        },
        "additionalProperties": false,
        "required": [
          "user_google_email",
          "spreadsheet_id",
          "range_name",
          "values"
        ]
      }
    },
    {
