{
  "tools": [
    {
      "name": "find_keep_notes",
      "description": "Find Google Keep notes using the unofficial master-token backend with query, label, color, pin, archive, and trash filters.",
      "parameters": {
        "type": "object",
        "properties": {
          "user_google_email": { "type": "string" },
          "query": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "colors": { "type": "array", "items": { "type": "string" } },
          "pinned": { "type": "boolean" },
          "archived": { "type": "boolean", "default": false },
          "trashed": { "type": "boolean", "default": false },
          "page_size": { "type": "number", "default": 25 },
          "page_token": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_keep_list",
      "description": "Create a Google Keep checklist using the unofficial master-token backend.",
      "parameters": {
        "type": "object",
        "properties": {
          "user_google_email": { "type": "string" },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "checked": { "type": "boolean" }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
