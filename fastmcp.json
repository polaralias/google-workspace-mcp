{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.11",
    "project": "."
  },
  "deployment": {
    "transport": "streamable-http",
    "host": "127.0.0.1",
    "port": 3002,
    "path": "/mcp",
    "log_level": "INFO",
    "env": {
      "GOOGLE_MCP_CREDENTIALS_DIR": "${GOOGLE_MCP_CREDENTIALS_DIR}",
      "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
      "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
      "GOOGLE_DEFAULT_USER_EMAIL": "${GOOGLE_DEFAULT_USER_EMAIL}",
      "GOOGLE_KEEP_EMAIL": "${GOOGLE_KEEP_EMAIL}",
      "GOOGLE_KEEP_MASTER_TOKEN": "${GOOGLE_KEEP_MASTER_TOKEN}",
      "GOOGLE_KEEP_UNSAFE_MODE": "${GOOGLE_KEEP_UNSAFE_MODE}",
      "GOOGLE_KEEP_MANAGED_LABEL": "${GOOGLE_KEEP_MANAGED_LABEL}",
      "GOOGLE_SERVICE_ACCOUNT_FILE": "${GOOGLE_SERVICE_ACCOUNT_FILE}",
      "GOOGLE_SERVICE_ACCOUNT_JSON": "${GOOGLE_SERVICE_ACCOUNT_JSON}",
      "GOOGLE_IMPERSONATED_USER": "${GOOGLE_IMPERSONATED_USER}",
      "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
      "MASTER_KEY": "${MASTER_KEY}",
      "API_KEY_MODE": "${API_KEY_MODE}",
      "GOOGLE_WORKSPACE_MCP_API_KEY": "${GOOGLE_WORKSPACE_MCP_API_KEY}",
      "MCP_API_KEY": "${MCP_API_KEY}",
      "MCP_API_KEYS": "${MCP_API_KEYS}",
      "MCP_TRANSPORT": "streamable-http",
      "MCP_HOST": "127.0.0.1",
      "MCP_PORT": "3002",
      "MCP_PATH": "/mcp",
      "FASTMCP_TRANSPORT": "streamable-http",
      "HOST": "127.0.0.1",
      "PORT": "3002"
    }
  }
}
